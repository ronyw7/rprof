#!/usr/bin/env python3
# hog-mem SIZE [SECONDS]: allocate and touch SIZE bytes (K/M/G = KiB/MiB/GiB), then hold them.
import re, sys, time
m = re.fullmatch(r"(\d+)([KMGT])?i?B?", sys.argv[1]); held = b"\x01" * (int(m[1]) << {"K": 10, "M": 20, "G": 30, "T": 40}.get(m[2] or "", 0))
time.sleep(float(sys.argv[2]) if len(sys.argv) > 2 else 3600)
